# Build products
build/
DerivedData/
*.o
*.dSYM/

# Phase 0 probe binaries (rebuilt by poc/p0-probe/run_probe.sh)
poc/p0-probe/p0_probe
poc/p0-probe/probe_[A-Z]
poc/p0-probe/*.plist.bak

# Signing / local secrets — never commit
*.mobileprovision
*.provisionprofile
*.p12
*.cer

# macOS
.DS_Store

# Logs and captures
*.log
captures/

# Generated at runtime by poc/p0-probe/run_probe.sh
poc/p0-probe/ent_*.plist
poc/p1-capture-test/capture_test

# CMake build tree
airusb/build/
compile_commands.json
.cache/

# Output of scripts/cross-build-windows.sh
airusb/build-win/

# Xcode.
#
# .gitignore has no trailing comments — "path/  # note" makes the pattern
# literally include the spaces and the note, and silently matches nothing.
# Both of these are generated from apple/project.yml by xcodegen.
apple/AirUSBHub.xcodeproj/
apple/Sources/Info.plist
apple/build/

# Runtime state, and one of these is a PRIVATE KEY.
#
# *.id is a raw Ed25519 seed: whoever holds it can be this machine to every peer
# that has pinned it. *.peers is the pin store, *.token is the control-plane
# bearer token. None of them is source, all of them are written into whatever
# directory a tool was started from, and a root-run exportd drops them wherever
# the operator happened to be — which was the repository root. `git add -A`
# reached for the seed before this rule existed.
airusb-*.id
airusb-*.peers
airusb-*.token
